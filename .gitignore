# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
.env
.env.local
.env.docker.local
backend/.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/
env/
dist/
