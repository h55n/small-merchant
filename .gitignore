backend/results/*.json

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── Docker / OS ───────────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
