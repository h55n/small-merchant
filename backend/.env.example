# ── AI Provider Keys (system uses the first one that works, in order) ──────────
# Provide at least ONE of these. The system cascades through providers automatically.

# Anthropic Claude (recommended primary)
ANTHROPIC_API_KEY=

# OpenAI (fallback #1)
OPENAI_API_KEY=

# Google Gemini (fallback #2)
GEMINI_API_KEY=

# Ollama local endpoint (fallback #3 — no key needed if running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embedding Provider (for catalog search) ─────────────────────────────────
# Uses the same key order: OpenAI → Gemini → local sentence-transformers fallback
EMBEDDING_PROVIDER=auto   # auto | openai | gemini | local

# ── Razorpay Test Mode ───────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys (use TEST mode keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Webhook secret for HMAC-SHA256 signature verification (Phase 1.4)
# Set at https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=

# ── Google Sheets (optional — for Sheets import) ────────────────────────────
# Create a service account at console.cloud.google.com and download JSON
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# ── App Config ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# JWT signing key — MUST be changed in production (min 32 chars)
SECRET_KEY=change-this-in-production-use-a-long-random-string
LOG_LEVEL=INFO

# ── Redis (Phase 3.2 — optional, enables distributed session state) ──────────
# Leave empty to use in-memory session state (single server only)
REDIS_URL=
# Example: redis://localhost:6379

