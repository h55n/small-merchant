# Docker environment template
# Copy to .env.docker and fill in local/deployment values.
# Never commit the real .env.docker file.

# Database
POSTGRES_PASSWORD=changeme_use_a_strong_password_here

# AI providers (provide at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Razorpay test mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# App security
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-char-random-hex-string

# Optional
EMBEDDING_PROVIDER=auto
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost
