# ── Docker Environment Template ────────────────────────────────────────────────
# Copy this file to .env.docker and fill in your values.
# NEVER commit .env.docker with real secrets to version control.
# Add .env.docker to .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_use_a_strong_password_here

# ── AI Providers (provide at least one) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# ── Razorpay Test Mode ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# ── App Security ──────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-char-random-hex-string

# ── Optional ──────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=auto
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost
